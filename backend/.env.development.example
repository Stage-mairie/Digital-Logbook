NODE_ENV=development
PORT=3000

# IMPORTANT : garder la même valeur que celle utilisée pour créer le vault.
VAULT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
SESSION_DAYS=180

# Laisser vide en local : les origines localhost / 127.0.0.1 sont autorisées.
CORS_ORIGINS=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=digital_logbook
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_SSL=false
