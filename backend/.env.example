# ------------------------------------------------------------
# DIGITAL LOGBOOK - EXEMPLE DE CONFIGURATION
# ------------------------------------------------------------
# Pour le développement local, voir aussi .env.development.example
# Pour la production, voir .env.production.example et ../DEPLOYMENT.md

NODE_ENV=development
PORT=3000
VAULT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
SESSION_DAYS=180

# Origines Web autorisées, séparées par des virgules.
# En développement, localhost est autorisé automatiquement.
# Exemple production :
# CORS_ORIGINS=https://digital-logbook.example.fr,https://logbook.example.fr
CORS_ORIGINS=

# PostgreSQL local
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=digital_logbook
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_SSL=false

# Alternative pour un PostgreSQL hébergé :
# DATABASE_URL=postgresql://user:password@host:5432/digital_logbook
