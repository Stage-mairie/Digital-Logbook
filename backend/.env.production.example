NODE_ENV=production
PORT=3000

# Générer une longue valeur aléatoire et NE JAMAIS la committer.
# Exemple de génération :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
VAULT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
SESSION_DAYS=180

# Domaine(s) qui hébergent Flutter Web, séparés par des virgules.
# Ne pas mettre * avec une API authentifiée.
CORS_ORIGINS=https://digital-logbook.example.fr

# OPTION A - PostgreSQL sur le même serveur que le backend :
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=digital_logbook
DB_USER=digital_logbook_app
DB_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD
DB_SSL=false

# OPTION B - PostgreSQL managé / distant :
# Commenter les DB_* ci-dessus et renseigner DATABASE_URL.
# DATABASE_URL=postgresql://user:password@db-host:5432/digital_logbook
# DB_SSL=true
