# Développement Docker — copier vers .env (non versionné).
COMPOSE_PROJECT_NAME=digital-logbook-dev
DB_NAME=digital_logbook
DB_USER=digital_logbook
DB_PASSWORD=CHANGE_ME_DEV_DB_PASSWORD
# Utiliser le secret EXISTANT si backend/vault/users.vault.enc existe déjà.
VAULT_SECRET=CHANGE_ME_DEV_VAULT_SECRET
SESSION_DAYS=180
API_PORT=3000
WEB_PORT=8080
ENABLE_SIGNATURES=true
