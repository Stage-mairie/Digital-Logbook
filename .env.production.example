# À créer sur le serveur sous le nom .env.production (non versionné).
COMPOSE_PROJECT_NAME=digital-logbook-prod
DB_NAME=digital_logbook
DB_USER=digital_logbook_app
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# Doit être cohérent avec backend/vault/users.vault.enc ; ne pas recopier les comptes démo en PROD.
VAULT_SECRET=CHANGE_ME_STRONG_VAULT_SECRET
SESSION_DAYS=180
# La collecte ET la consultation des signatures sont actives en production.
# Validation DPO, information des agents et règles de conservation avant mise en service.
ENABLE_SIGNATURES=true
# Nginx est exposé sur l'hôte local ; un reverse proxy TLS externe est requis.
WEB_PORT=8080
CORS_ORIGINS=https://logbook.example.fr
