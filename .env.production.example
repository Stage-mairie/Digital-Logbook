# Copier vers .env.production (non versionné), chmod 600 sur Linux.
APP_DOMAIN=logbook.saint-andre.re
WEB_PORT=8080
DB_NAME=digital_logbook
DB_USER=digital_logbook_app
DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
# Ne jamais modifier ce secret sans recréer/faire migrer le vault.
VAULT_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
SESSION_DAYS=1
ENABLE_SIGNATURES=true
CORS_ORIGINS=https://logbook.saint-andre.re
